{
  "name":
    "evm-chains-info",
  "version":
    "0.0.36",
  "description":
    "Returns information about Ethereum Virtual Machine (EVM) blockchains.",
  "funding": {
    "type":
      "patreon",
    "url":
      "https://patreon.com/tallero"
  },
  "man": [
    "./man/evm-chains-info.js.1"
  ],
  "files": [
    "AUTHORS.rst",
    "COPYING",
    "README.md",
    "dist",
    "evm-chains-info",
    "libevm-chains-info",
    "fs-worker.webpack.config.cjs",
    "package.json",
    "serve.json",
    "webpack.config.cjs"
  ],
  "keywords": [
    "ur",
    "themartiancompany",
    "dogeos",
    "ethereum",
    "evmfs"
  ],
  "homepage":
    "https://github.com/themartiancompany/evm-chains-info.js",
  "bugs": {
    "url":
      "https://github.com/themartiancompany/evm-chains-info.js/issues"
  },
  "repository": {
    "type":
      "git",
    "url":
      "git+https://github.com/themartiancompany/evm-chains-info.js.git"
  },
  "license":
    "AGPL-3.0-or-later",
  "author": {
    "name":
      "Pellegrino Prevete",
    "email":
      "pellegrinoprevete@gmail.com",
    "url":
      "https://github.com/tallero"
  },
  "devDependencies": {
    "crash-js-webpack":
      "^0.0.78",
    "flatted":
      "^3.4.4",
    "eslint":
      "^10.9.0",
    "globals":
      "^17.3.0",
    "@eslint/js":
      "^10.0.1",
    "safely-serve":
      "^0.0.21",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2"
  },
  "dependencies": {
    "libcrash-js":
      "npm:crash-js@^1000000000000012.1000000000000001.1000000000000001",
    "ethereum-data":
      "^0.0.11",
    "yargs":
      "18.0.0"
  },
  "optionalDependencies": {
    "evm-wallet":
      "npm:evm-wallet.js@^0.0.95"
  },
  "overrides": {
    "evm-chains-info":
      "./libevm-chains-info",
    "evm-contracts-tools":
      "^0.0.60",
    "evm-wallet":
      "npm:evm-wallet.js@^0.0.95"
  },
  "type":
    "module",
  "main":
    "libevm-chains-info",
  "bin": {
    "evm-chain-info":
        "evm-chains-info",
    "evm-chains-info.js":
      "evm-chains-info"
  },
  "scripts": {
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details && cp 'fs-worker.js' 'dist/evm-chains-info' && cp 'fs-worker.js' 'dist/evm-chains-info'",
    "build-lib":
      "npx webpack --mode 'production' --config 'libevm-chains-info.webpack.config.cjs' --stats-error-details && mv 'libevm-chains-info.js' 'dist/libevm-chains-info'",
    "build-bin":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details && mv 'evm-chains-info.js' 'dist/evm-chains-info'",
    "build":
      "npm run lint && npm run build-fs-worker && npm run build-lib && npm run build-bin",
    "lint":
      "npx eslint .",
    "publish-npm":
      "npm run build && npm publish --access public",
    "start":
      "npx safely-serve 'dist/evm-chains-info' --port 3000 --https --no-cache",
    "test":
      "echo \"Error: no test specified\" && exit 1"
  }
}
